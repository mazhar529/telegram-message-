# Telegram
TELEGRAM_BOT_TOKEN=123456789:REPLACE_WITH_YOUR_BOT_TOKEN
TELEGRAM_CHAT_ID=REPLACE_WITH_YOUR_CHAT_ID

# Protect the webhook so random people cannot submit data.
THINNEST_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Private/local Ollama (recommended for caller PII)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gpt-oss:20b

# Optional: set to false only if your deployment cannot reach Ollama.
REQUIRE_AI=true

# Max characters of raw webhook data sent to the local model.
MAX_AI_INPUT_CHARS=30000
